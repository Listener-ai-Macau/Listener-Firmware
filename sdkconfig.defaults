CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_HID_SERVICE=y
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_SM_LVL=2
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=517
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_COUNT=50
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Voice Keyboard V1.0 hardware: SPH0645 I2S digital microphone
CONFIG_AUDIO_CAPTURE_MIC_SPH0645=y
CONFIG_AUDIO_CAPTURE_SPH0645_SLOT_LEFT=y
CONFIG_AUDIO_CAPTURE_SPH0645_GAIN=4
