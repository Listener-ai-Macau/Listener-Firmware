choice AUDIO_CAPTURE_MIC_TYPE
    prompt "Microphone hardware type"
    default AUDIO_CAPTURE_MIC_SPH0655_PDM
    help
        Select the microphone hardware connected to the audio capture peripheral.
        ES8311: Analog codec via I2C + I2S (legacy board).
        SPH0655: PDM digital microphone on the V2 N16R8 CLK/DOUT interface.

config AUDIO_CAPTURE_MIC_ES8311
    bool "ES8311 analog codec (legacy board)"

config AUDIO_CAPTURE_MIC_SPH0655_PDM
    bool "SPH0655 PDM digital mic (V2 N16R8)"

endchoice

config AUDIO_CAPTURE_V2_MIC_INTERFACE_VALIDATED
    bool "Enable V2 microphone capture after CLK/DOUT interface validation"
    default n
    depends on AUDIO_CAPTURE_MIC_SPH0655_PDM
    help
        Enable only for V2 hardware validation builds that must exercise the
        CLK/GPIO48 and DOUT/GPIO47 microphone path. When disabled, firmware
        reports a degraded audio path instead of pretending capture is ready.
