CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_HID_SERVICE=y
CONFIG_BT_NIMBLE_DIS_SERVICE=y
CONFIG_BT_NIMBLE_SVC_DIS_MANUFACTURER_NAME=y
CONFIG_BT_NIMBLE_SVC_DIS_SERIAL_NUMBER=y
CONFIG_BT_NIMBLE_SVC_DIS_HARDWARE_REVISION=y
CONFIG_BT_NIMBLE_SVC_DIS_FIRMWARE_REVISION=y
CONFIG_BT_NIMBLE_SVC_DIS_SOFTWARE_REVISION=y
CONFIG_BT_NIMBLE_SVC_DIS_PNP_ID=y
CONFIG_BT_NIMBLE_NVS_PERSIST=y
# Keep recovery identity rotation coherent with the local IRK after all bonds
# are deleted, preventing Windows BTHUSB event 35 on a fresh native re-pair.
CONFIG_BT_NIMBLE_SMP_ID_RESET=y
CONFIG_BT_NIMBLE_SM_LVL=2
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=517
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_COUNT=64
CONFIG_BT_NIMBLE_MSYS_2_BLOCK_COUNT=96
CONFIG_BT_NIMBLE_TRANSPORT_ACL_FROM_LL_COUNT=24
# Honor the active-audio min/max connection-event request from BLE GAP.
CONFIG_BT_CTRL_CE_LENGTH_TYPE_CE=y
CONFIG_BT_NIMBLE_LOG_LEVEL_WARNING=y
CONFIG_BT_BLE_42_FEATURES_SUPPORTED=y
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Watchdog / boot recovery safety
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=5
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=y
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=y
CONFIG_ESP_INT_WDT=y
CONFIG_ESP_INT_WDT_TIMEOUT_MS=300
CONFIG_ESP_INT_WDT_CHECK_CPU1=y

# CONFIG_AUDIO_CAPTURE_MIC_ES8311 is not set
CONFIG_AUDIO_CAPTURE_MIC_SPH0655_PDM=y
CONFIG_AUDIO_CAPTURE_PDM_STEREO_SLOT_CAPTURE=y
# CONFIG_AUDIO_CAPTURE_SPH0655_SLOT_RIGHT is not set
# CONFIG_AUDIO_CAPTURE_SPH0655_CLK_INVERT is not set
CONFIG_AUDIO_CAPTURE_V2_MIC_INTERFACE_VALIDATED=y

# Voice Keyboard V2 validation module: ESP32-S3-WROOM-1-N16R8.
CONFIG_LISTENER_BOARD_PROFILE_V2_N16R8=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_I2S_ISR_IRAM_SAFE=y

# Low-power hardware shutdown guard
CONFIG_POWER_MANAGER_ENABLE=y
CONFIG_POWER_MANAGER_AUDIO_IDLE_MS=5000
CONFIG_POWER_MANAGER_CONNECTED_IDLE_MS=60000
CONFIG_POWER_MANAGER_DISCONNECTED_IDLE_MS=60000
CONFIG_POWER_MANAGER_HARDWARE_SHUTDOWN_MS=600000
CONFIG_POWER_MANAGER_EVALUATE_INTERVAL_MS=2000
CONFIG_POWER_MANAGER_LOW_POWER_HEALTH_INTERVAL_S=600

# ESP32-S3 idle power reduction while keeping BLE responsive
CONFIG_PM_ENABLE=y
CONFIG_PM_SLEEP_FUNC_IN_IRAM=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
CONFIG_FREERTOS_IDLE_TIME_BEFORE_SLEEP=3
# Keep the BLE controller awake. Windows HID pairing is sensitive to missed HCI
# control events during SMP / remote feature exchange. Runtime PM keeps DFS,
# while main/main.c globally disables automatic Light Sleep: without controller
# modem sleep, real CONNECTED_IDLE transitions caused ESP_RST_INT_WDT. The
# connected NO_LIGHT_SLEEP lock remains a defensive invariant, not the sole gate.
# CONFIG_BT_CTRL_MODEM_SLEEP is not set
CONFIG_BT_CTRL_LPCLK_SEL_MAIN_XTAL=y
CONFIG_BT_CTRL_MAIN_XTAL_PU_DURING_LIGHT_SLEEP=y
CONFIG_USJ_NO_AUTO_LS_ON_CONNECTION=y
