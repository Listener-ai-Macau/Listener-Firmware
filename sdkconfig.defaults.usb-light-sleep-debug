# Separate-build debug profile: release defaults keep USB Serial/JTAG awake
# while connected so flashing and serial diagnostics remain reliable. This
# opt-in profile deliberately allows automatic light sleep while USB
# Serial/JTAG is connected. Expect Windows COM disconnects, phantom ports, or
# missed console traffic during idle light-sleep windows.
# CONFIG_USJ_NO_AUTO_LS_ON_CONNECTION is not set

# Keep the BLE controller on the accurate main XTAL path, but allow automatic
# light sleep by powering the main XTAL during light sleep.
CONFIG_BT_CTRL_MAIN_XTAL_PU_DURING_LIGHT_SLEEP=y
