import sys, time, serial
port = 'COM6'

def read_for(ser, seconds, label):
    end = time.time() + seconds
    chunks = []
    while time.time() < end:
        data = ser.read(4096)
        if data:
            chunks.append(data)
    if chunks:
        raw = b''.join(chunks)
        text = raw.decode('utf-8', errors='replace')
        print(f'--- {label}: {len(raw)} bytes / {len(text)} chars ---')
        print(text)
    else:
        print(f'--- {label}: <no serial output> ---')

def open_port(baud):
    ser = serial.Serial()
    ser.port = port
    ser.baudrate = baud
    ser.timeout = 0.2
    ser.dsrdtr = False
    ser.rtscts = False
    ser.dtr = False
    ser.rts = False
    ser.open()
    return ser

for baud in (115200, 460800):
    print(f'=== passive_read baud={baud} ===')
    ser = open_port(baud)
    try:
        print(f'opened={ser.is_open} dtr={ser.dtr} rts={ser.rts}')
        read_for(ser, 1.5, f'passive baud={baud}')
        if baud == 115200:
            for cmd in ['\n', '~BOARD:STATUS\n', '~BOARD:GPIO\n', '~DIAGLOG:COUNT\n', '~DIAGLOG:LAST:8\n']:
                print(f'write={cmd.strip()!r}')
                ser.write(cmd.encode('utf-8'))
                ser.flush()
                time.sleep(0.25)
                read_for(ser, 0.75, f'after {cmd.strip() or "newline"}')
    finally:
        ser.close()

print('=== dtr_rts_reset_probe baud=115200 ===')
patterns = [
    ('idle_false_false', False, False, 1.0),
    ('rts_true_then_false', False, True, 0.15),
    ('after_rts_release', False, False, 1.5),
    ('dtr_true_then_false', True, False, 0.15),
    ('after_dtr_release', False, False, 1.5),
    ('both_true_then_false', True, True, 0.15),
    ('after_both_release', False, False, 1.5),
]
ser = open_port(115200)
try:
    for label, dtr, rts, delay in patterns:
        ser.dtr = dtr
        ser.rts = rts
        print(f'set {label}: dtr={ser.dtr} rts={ser.rts} delay={delay}')
        time.sleep(delay)
        read_for(ser, 0.5, label)
finally:
    ser.close()
"@
