menu "Listener Power Manager"
    config POWER_MANAGER_ENABLE
        bool "Enable firmware low-power manager and hardware shutdown guard"
        default y

    config POWER_MANAGER_CONNECTED_IDLE_MS
        int "BLE connected idle threshold in milliseconds"
        default 30000
        depends on POWER_MANAGER_ENABLE

    config POWER_MANAGER_AUDIO_IDLE_MS
        int "Audio idle power-save threshold in milliseconds"
        default 5000
        depends on POWER_MANAGER_ENABLE

    config POWER_MANAGER_DISCONNECTED_IDLE_MS
        int "BLE disconnected idle threshold in milliseconds"
        default 30000
        depends on POWER_MANAGER_ENABLE

    config POWER_MANAGER_HARDWARE_SHUTDOWN_MS
        int "Hardware shutdown threshold in milliseconds"
        default 1800000
        depends on POWER_MANAGER_ENABLE

    config POWER_MANAGER_BATTERY_CRITICAL_PERCENT
        int "Battery percentage threshold for critical hardware shutdown"
        default 5
        depends on POWER_MANAGER_ENABLE
        range 1 100

    config POWER_MANAGER_EVALUATE_INTERVAL_MS
        int "Power manager evaluation interval in milliseconds"
        default 2000
        depends on POWER_MANAGER_ENABLE

    config POWER_MANAGER_LOW_POWER_HEALTH_INTERVAL_S
        int "System-health interval while idle in seconds"
        default 600
        depends on POWER_MANAGER_ENABLE
endmenu
